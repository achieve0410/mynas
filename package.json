{
  "name": "mynas",
  "version": "0.1.0",
  "description": "Local-first mirrored NAS and photo gallery for macOS",
  "homepage": "https://github.com/achieve0410/mynas#readme",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/achieve0410/mynas.git"
  },
  "bugs": {
    "url": "https://github.com/achieve0410/mynas/issues"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:web": "vite build",
    "format": "biome format --write .",
    "lint": "biome check .",
    "mynas": "bun apps/cli/src/main.ts",
    "prepublishOnly": "bun -e 'throw new Error(\"MyNAS is not distributed through npm\")'",
    "qa:docker": "bun tests/packaging/docker-live.ts",
    "qa:kubernetes": "bun tests/packaging/kubernetes-validate.ts",
    "qa:packaging": "bun test tests/packaging/packaging.test.ts",
    "qa:release": "bun tests/packaging/release-audit.ts",
    "test": "bun test apps packages tests/api tests/cli tests/packaging",
    "test:browser": "bun tests/browser/run.ts",
    "typecheck": "tsc --noEmit",
    "verify": "bun run lint && bun run typecheck && bun run build:web && bun run test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tanstack/react-query": "5.101.4",
    "commander": "15.0.0",
    "hono": "4.13.1",
    "lucide-react": "1.31.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/bun": "1.3.14",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "typescript-language-server": "5.3.0",
    "vite": "8.2.1"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
