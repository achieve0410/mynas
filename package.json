{
  "name": "mynas",
  "version": "0.1.0",
  "description": "Local-first mirrored NAS and photo gallery for macOS",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "commander": "15.0.0",
    "hono": "4.13.1",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2",
    "typescript-language-server": "5.3.0"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
