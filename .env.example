# Native CLI
MYNAS_URL=http://127.0.0.1:7331
MYNAS_TOKEN=

# Native service logger
MYNAS_LOG_LEVEL=info

# Docker Compose host settings
MYNAS_PORT=7331
MYNAS_STORAGE_PATH=./storage

# QA-only MinIO profile
MYNAS_QA_S3_ACCESS_KEY=mynas-qa-access
MYNAS_QA_S3_SECRET_KEY=mynas-qa-secret-only
MYNAS_TEST_S3_BUCKET=mynas-test

# Optional live S3 test against the QA MinIO service
MYNAS_TEST_S3_ENDPOINT=http://127.0.0.1:9000
MYNAS_TEST_S3_ACCESS_KEY=mynas-qa-access
MYNAS_TEST_S3_SECRET_KEY=mynas-qa-secret-only
